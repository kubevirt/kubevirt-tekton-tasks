#!/bin/sh -e

# /etc/passwd is not modified at runtime: Task steps run with a read-only root
# filesystem. The passwd entry for the default image user is created at build
# time (see user_setup) and the container runtime (CRI-O) generates one for an
# arbitrary UID, using $HOME as its home directory.

#this variable is needed for tasks which work with ssh keys
export USER="tekton-tasks"

if [[ -z "${COMMAND}" ]]; then
  echo "command not defined"
  exit 1
fi

exec ${COMMAND} $@
